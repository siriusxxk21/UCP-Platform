<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.richuang</groupId>
        <artifactId>os-nocode</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>os-nocode-tools</artifactId>
    <packaging>jar</packaging>
    <dependencies>
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-nocode-web</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <scope>test</scope>
            <groupId>com.richuang</groupId>
            <artifactId>os-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>
        <!-- 业务附件保存回归必须覆盖真实网盘 Mapper 与权限拦截器，不能只模拟领域 API。 -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-module-drive</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
        <!-- 目录候选回归使用真实用户组 API、Service 与 Mapper 默认查询。 -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-module-bpm-core</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>db/nocode/**</exclude>
                </excludes>
            </resource>
            <!-- SQL 唯一源在服务端 sql；保留原 classpath，迁移版本和校验和不变。 -->
            <resource>
                <directory>${project.basedir}/../../sql/postgresql/migrations</directory>
                <targetPath>db/nocode</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>V*__*.sql</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}/../../sql/postgresql</directory>
                <targetPath>db</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>migrations.lock.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- 测试也从正式启动模块加载配置，不维护第二份配置文件。 -->
            <testResource>
                <directory>${project.basedir}/../../os-server/src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>application*.yml</include>
                </includes>
            </testResource>
        </testResources>
    </build>
</project>
