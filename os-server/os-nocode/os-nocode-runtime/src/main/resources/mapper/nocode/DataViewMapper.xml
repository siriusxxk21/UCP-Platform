<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.richuang.os.nocode.runtime.dal.mapper.DataViewMapper">
    <!--
        sectionIndex 仅由 XML 遍历或已验证的视图配置定位；各来源独立聚合，避免一对多相乘。
        viewPrefix 在子表查询时为 view.，保留当前参数路径及每一来源的权限条件。
    -->
    <sql id="sectionFrom">
        FROM
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordTable">
            <property name="recordValue" value="_view.sections[_sectionIndex].statement"/>
        </include>
        t
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordWhere">
            <property name="recordValue" value="_view.sections[_sectionIndex].statement"/>
            <property name="prefix" value="${viewPrefix}sections[${_sectionIndex}].statement."/>
            <property name="prefixExpression" value="'${viewPrefix}sections[' + _sectionIndex + '].statement.'"/>
            <property name="alias" value="t"/>
        </include>
        AND (${_view.sections[_sectionIndex].correlation})
    </sql>

    <sql id="source">
        <bind name="_view" value="_parameter"/>
        WITH source AS (
        SELECT r.*, to_jsonb(r) AS __root_json
        <foreach collection="_view.columns" item="_column">
            <bind name="_kind" value="@com.richuang.os.nocode.enums.ViewColumnKindEnum@fromCode(_column.kind).name()"/>
            <bind name="_sectionIndex" value="_column.section"/>
            ,
            <choose>
                <when test="_kind == 'DETAIL'">
                    g.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_column.sourceColumn)}
                </when>
                <when test="_kind == 'LOOKUP'">
                    (SELECT t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_column.sourceColumn)}
                    <include refid="sectionFrom">
                        <property name="viewPrefix" value=""/>
                    </include>
                    LIMIT 1)
                </when>
                <otherwise>
                    (SELECT ${_kind}(
                    <choose>
                        <when test="_kind == 'COUNT'">*</when>
                        <otherwise>
                            t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_column.sourceColumn)}
                        </otherwise>
                    </choose>
                    )
                    <include refid="sectionFrom">
                        <property name="viewPrefix" value=""/>
                    </include>
                    )
                </otherwise>
            </choose>
            AS ${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_column.id)}
        </foreach>
        <if test="_view.grainSection != null">
            , g.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_view.sections[_view.grainSection].statement.keyColumn)}::text AS __detail_id
        </if>
        FROM
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordTable">
            <property name="recordValue" value="_view.root"/>
        </include>
        r
        <if test="_view.grainSection != null">
            <bind name="_sectionIndex" value="_view.grainSection"/>
            JOIN LATERAL (SELECT t.*
            <include refid="sectionFrom">
                <property name="viewPrefix" value=""/>
            </include>
            <!-- 按明细行统计的下钻：只留命中的明细行（统计下钻给出的明细行主键）。 -->
            <if test="_view.grainKeys != null">
                AND t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_view.sections[_view.grainSection].statement.keyColumn)}::text IN (SELECT jsonb_array_elements_text(CAST(#{grainKeys} AS jsonb)))
            </if>
            ) g ON TRUE
        </if>
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordWhere">
            <property name="recordValue" value="_view.root"/>
            <property name="prefix" value="root."/>
            <property name="prefixExpression" value="'root.'"/>
            <property name="alias" value="r"/>
        </include>
        <foreach collection="_view.sections" item="_section" index="_sectionIndex">
            <if test="_section.requireMatch">
                AND EXISTS (SELECT 1
                <include refid="sectionFrom">
                    <property name="viewPrefix" value=""/>
                </include>
                )
            </if>
        </foreach>
        )
    </sql>

    <sql id="viewWhere">
        <if test="conditions != null and !conditions.sqlSegment.isBlank()">
            WHERE ${conditions.sqlSegment.replace('#{dynamicQuery.', '#{conditions.')}
        </if>
    </sql>

    <select
        id="rows"
        parameterType="com.richuang.os.nocode.runtime.dal.query.DataViewStatement"
        resultType="java.lang.String"
        useCache="false"
        flushCache="true">
        <include refid="source"/>
        SELECT jsonb_build_object(
            'record', (
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordProjection">
            <property name="recordValue" value="root"/>
            <property name="revisionSource" value="t.__root_json"/>
        </include>
        )::jsonb,
            'extra',
        <choose>
            <when test="columns.isEmpty()">'{}'::jsonb</when>
            <otherwise>
                jsonb_build_object(
                <foreach collection="columns" item="_column" separator=",">
                        '${_column.id}', t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(_column.id)}
                    <if test="_column.numeric">::text</if>
                </foreach>
                )
            </otherwise>
        </choose>
        ,
            'detailId',
        <choose>
            <when test="grainSection == null">NULL</when>
            <otherwise>t.__detail_id</otherwise>
        </choose>
        )::text FROM source t
        <include refid="viewWhere"/>
        ORDER BY t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(sortColumn == null ? root.keyColumn : sortColumn)}
        <choose>
            <when test="descending">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
        ,
        t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(root.keyColumn)}
        <if test="grainSection != null">, t.__detail_id</if>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" parameterType="com.richuang.os.nocode.runtime.dal.query.DataViewStatement" resultType="_long">
        <include refid="source"/>
        SELECT count(*) FROM source t
        <include refid="viewWhere"/>
    </select>

    <sql id="childFrom">
        <bind name="_view" value="view"/>
        <bind name="_sectionIndex" value="section"/>
        FROM
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordTable">
            <property name="recordValue" value="view.root"/>
        </include>
        r
        JOIN LATERAL (SELECT t.*
        <include refid="sectionFrom">
            <property name="viewPrefix" value="view."/>
        </include>
        ) t ON TRUE
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordWhere">
            <property name="recordValue" value="view.root"/>
            <property name="prefix" value="view.root."/>
            <property name="prefixExpression" value="'view.root.'"/>
            <property name="alias" value="r"/>
        </include>
        AND r.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(view.root.keyColumn)}::text = #{recordId}
    </sql>

    <select
        id="childRows"
        parameterType="com.richuang.os.nocode.runtime.dal.query.DataViewChildStatement"
        resultType="java.lang.String"
        useCache="false"
        flushCache="true">
        SELECT
        <include refid="com.richuang.os.nocode.runtime.dal.mapper.RecordMapper.recordProjection">
            <property name="recordValue" value="view.sections[section].statement"/>
            <property name="revisionSource" value="to_jsonb(t)"/>
        </include>
        <include refid="childFrom"/>
        ORDER BY t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(sortColumn == null ? view.sections[section].statement.keyColumn : sortColumn)}
        <choose>
            <when test="descending">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
        ,
        t.${@com.richuang.os.nocode.runtime.dal.support.RuntimeSqlParameters@quote(view.sections[section].statement.keyColumn)}
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="childCount" parameterType="com.richuang.os.nocode.runtime.dal.query.DataViewChildStatement" resultType="_long">
        SELECT count(*)
        <include refid="childFrom"/>
    </select>
</mapper>
