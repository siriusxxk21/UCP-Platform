<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.richuang.os.nocode.metadata.dal.mapper.ObjectOperationDataMapper">
    <resultMap id="counts" type="com.richuang.os.nocode.metadata.dal.mapper.ObjectOperationDataMapper$Counts">
        <constructor>
            <arg column="rows" javaType="_long"/>
            <arg column="non_nulls" javaType="_long"/>
        </constructor>
    </resultMap>
    <sql id="tableIdentifiers">
        <bind name="_schema" value="@com.richuang.os.framework.mybatis.core.metadata.PostgreSqlCommands@identifier(schema)"/>
        <bind name="_table" value="@com.richuang.os.framework.mybatis.core.metadata.PostgreSqlCommands@identifier(table)"/>
    </sql>
    <!-- 包含逻辑删除的全部物理行，不读取原值。 -->
    <select id="countRows" resultType="java.lang.Long" useCache="false" flushCache="true">
        <include refid="tableIdentifiers"/>
        SELECT count(*) FROM ${_schema}.${_table}
    </select>
    <select id="countColumn" resultMap="counts" useCache="false" flushCache="true">
        <include refid="tableIdentifiers"/>
        <bind name="_column" value="@com.richuang.os.framework.mybatis.core.metadata.PostgreSqlCommands@identifier(column)"/>
        SELECT count(*) AS rows, count(${_column}) AS non_nulls FROM ${_schema}.${_table}
    </select>
    <select id="countDuplicates" resultType="java.lang.Long" useCache="false" flushCache="true">
        <include refid="tableIdentifiers"/>
        <bind name="_column" value="@com.richuang.os.framework.mybatis.core.metadata.PostgreSqlCommands@identifier(column)"/>
        SELECT COALESCE(sum(n), 0)::bigint FROM (
            SELECT count(*) AS n FROM ${_schema}.${_table}
            WHERE ${_column} IS NOT NULL GROUP BY ${_column} HAVING count(*) &gt; 1
        ) conflicts
    </select>
</mapper>
