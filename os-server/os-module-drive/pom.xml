<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.richuang</groupId>
        <artifactId>os</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>os-module-drive</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        drive 模块，提供平台网盘能力：空间、目录与文件节点、权限授权、组织内分享、收藏与最近访问。
        文件内容统一落在 infra 文件底座，网盘只维护逻辑节点与授权，不复制存储实现，也不直接操作存储介质。
    </description>

    <dependencies>
        <!-- 对外 API 契约：业务文件融合等跨模块接口在此声明、本模块实现 -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-module-drive-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- 依赖底座模块：文件内容走 infra，用户与部门走 system -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-module-system</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.richuang</groupId>
            <artifactId>os-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
