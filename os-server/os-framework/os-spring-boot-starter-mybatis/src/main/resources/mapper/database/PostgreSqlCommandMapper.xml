<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.richuang.os.framework.mybatis.core.metadata.PostgreSqlCommandMapper">
    <!-- 参数只能由封闭的 Command 工厂产生；标识符、类型、常量及操作已在 Java 白名单校验。 -->
    <sql id="expression">
        <foreach collection="_column.expression" item="_token">
            <choose>
                <when test="_token.stage.name() == 'VALUE'">${_token.value}</when>
                <when test="_token.stage.name() == 'BINARY_START'">(</when>
                <when test="_token.stage.name() == 'BINARY_OPERATOR'">${_token.value}</when>
                <when test="_token.stage.name() == 'FUNCTION_START'">${_token.value}(</when>
                <when test="_token.stage.name() == 'SEPARATOR'">,</when>
                <when test="_token.stage.name() == 'CASE_START'">(CASE WHEN</when>
                <when test="_token.stage.name() == 'CASE_THEN'">THEN</when>
                <when test="_token.stage.name() == 'CASE_ELSE'">ELSE</when>
                <when test="_token.stage.name() == 'CASE_END'">END)</when>
                <when test="_token.stage.name() == 'NOT_START'">(NOT</when>
                <when test="_token.stage.name() == 'IS_BLANK_START'">(NULLIF((</when>
                <when test="_token.stage.name() == 'IS_BLANK_END'">)::text, '') IS NULL)</when>
                <when test="_token.stage.name() == 'NUMERIC_END'">)::numeric</when>
                <otherwise>)</otherwise>
            </choose>
        </foreach>
    </sql>

    <sql id="columnDefinition">
        ${_column.name} ${_column.type}
        <choose>
            <when test="_column.expression != null">
                GENERATED ALWAYS AS (<include refid="expression"/>) STORED
            </when>
            <when test="_column.identity">GENERATED BY DEFAULT AS IDENTITY</when>
            <when test="_column.defaultLiteral != null">DEFAULT ${_column.defaultLiteral}::${_column.type}</when>
        </choose>
        <choose>
            <when test="_column.primaryKey">PRIMARY KEY</when>
            <when test="_column.required">NOT NULL</when>
        </choose>
        <if test="_column.baseTime">DEFAULT CURRENT_TIMESTAMP</if>
        <if test="_column.baseDeleted">CHECK ("deleted" IN (0,1))</if>
    </sql>

    <sql id="command">
        <bind name="p" value="command.parameters"/>
        <bind name="operation" value="command.operation.name()"/>
        <choose>
            <when test="operation == 'CREATE_TABLE'">
                CREATE TABLE ${p.table} (
                <foreach collection="p.columns" item="_definition" separator=",">
                    <bind name="_column" value="_definition"/>
                    <include refid="columnDefinition"/>
                </foreach>
                )
            </when>
            <when test="operation == 'ADD_COLUMN'">
                ALTER TABLE ${p.table} ADD COLUMN
                <bind name="_column" value="p.column"/>
                <include refid="columnDefinition"/>
            </when>
            <when test="operation == 'ALTER_TYPE'">
                ALTER TABLE ${p.table} ALTER COLUMN ${p.column} TYPE ${p.type}
                <if test="p.usingCast">USING ${p.column}::${p.type}</if>
            </when>
            <when test="operation == 'REQUIRED'">
                ALTER TABLE ${p.table} ALTER COLUMN ${p.column}
                <choose><when test="p.required">SET</when><otherwise>DROP</otherwise></choose>
                NOT NULL
            </when>
            <when test="operation == 'DEFAULT_VALUE'">
                ALTER TABLE ${p.table} ALTER COLUMN ${p.column}
                <choose>
                    <when test="p.value == null">DROP DEFAULT</when>
                    <otherwise>SET DEFAULT ${p.value}::${p.type}</otherwise>
                </choose>
            </when>
            <when test="operation == 'DEFAULT_NOW'">
                ALTER TABLE ${p.table} ALTER COLUMN ${p.column} SET DEFAULT CURRENT_TIMESTAMP
            </when>
            <when test="operation == 'INDEX'">
                CREATE <if test="p.unique">UNIQUE</if> INDEX ${p.index} ON ${p.table} (
                <foreach collection="p.columns" item="column" separator=",">${column}</foreach>
                )
            </when>
            <when test="operation == 'DROP_INDEX'">DROP INDEX ${p.table}</when>
            <when test="operation == 'FOREIGN_KEY'">
                ALTER TABLE ${p.table} ADD CONSTRAINT ${p.constraint}
                FOREIGN KEY (${p.column}) REFERENCES ${p.targetTable} (${p.targetColumn}) ON DELETE
                <choose>
                    <when test="p.onDelete == 'CASCADE'">CASCADE</when>
                    <when test="p.onDelete == 'SET_NULL'">SET NULL</when>
                    <otherwise>RESTRICT</otherwise>
                </choose>
            </when>
            <when test="operation == 'DROP_CONSTRAINT'">
                ALTER TABLE ${p.table} DROP CONSTRAINT ${p.constraint}
            </when>
            <when test="operation == 'CHECK'">
                ALTER TABLE ${p.table} ADD CONSTRAINT ${p.constraint}
                CHECK (${p.column} ${p.operator} ${p.value})
            </when>
            <when test="operation == 'COMMENT'">
                COMMENT ON
                <choose>
                    <when test="p.column == null">TABLE ${p.table}</when>
                    <otherwise>COLUMN ${p.table}.${p.column}</otherwise>
                </choose>
                IS ${p.value}
            </when>
            <when test="operation == 'LOCK'">LOCK TABLE ${p.table} IN SHARE ROW EXCLUSIVE MODE</when>
            <when test="operation == 'WRITE_LOCK'">LOCK TABLE ${p.table} IN ROW EXCLUSIVE MODE</when>
            <when test="operation == 'STATEMENT_TIMEOUT'">SET LOCAL statement_timeout = '15000ms'</when>
            <when test="operation == 'LOCK_TIMEOUT'">SET LOCAL lock_timeout = '3000ms'</when>
            <when test="operation == 'HAS_ROWS'">SELECT EXISTS(SELECT 1 FROM ${p.table} LIMIT 1)</when>
            <when test="operation == 'HAS_NULL'">
                SELECT EXISTS(SELECT 1 FROM ${p.table} WHERE ${p.column} IS NULL LIMIT 1)
            </when>
            <when test="operation == 'DUPLICATES'">
                SELECT EXISTS(SELECT 1 FROM ${p.table} WHERE
                <foreach collection="p.present" item="column" separator=" AND ">${column} IS NOT NULL</foreach>
                GROUP BY
                <foreach collection="p.columns" item="column" separator=",">${column}</foreach>
                HAVING count(*) &gt; 1 LIMIT 1)
            </when>
            <when test="operation == 'ROWS'">
                SELECT row_to_json(preview_row)::text FROM (SELECT
                <foreach collection="p.columns" item="column" separator=",">${column}</foreach>
                FROM ${p.table}
                <if test="p.logicalDelete">WHERE "deleted"=0</if>
                <if test="!p.order.isEmpty()">
                    ORDER BY <foreach collection="p.order" item="column" separator=",">${column}</foreach>
                </if>
                LIMIT ${p.limit} OFFSET ${p.offset}) preview_row
            </when>
            <when test="operation == 'UNLINKED_ROWS'">
                SELECT EXISTS(SELECT 1 FROM ${p.table} c WHERE
                <if test="p.required">c.${p.column} IS NULL OR</if>
                (c.${p.column} IS NOT NULL AND NOT EXISTS(SELECT 1 FROM ${p.parentTable} p
                WHERE p.${p.parentKey}=c.${p.column})) LIMIT 1)
            </when>
        </choose>
    </sql>

    <!-- 保持原 Provider 的语句类型、缓存刷新和调用方事务；表锁权限忽略仍在 Java Mapper。 -->
    <update id="execute" flushCache="true"><include refid="command"/></update>
    <select id="check" resultType="java.lang.Boolean" useCache="false" flushCache="true">
        <include refid="command"/>
    </select>
    <select id="rows" resultType="java.lang.String" useCache="false" flushCache="true">
        <include refid="command"/>
    </select>
</mapper>
