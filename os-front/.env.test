# Playwright E2E 测试环境配置
# 本文件用于 Playwright 测试，不参与 Vite 构建
# 复制为 .env.test.local 并按需修改，.env.test.local 不会提交到 git

# 被测应用基础地址（本地起 dev server 后默认为 5173）
E2E_BASE_URL=http://10.8.0.7:30082

# 测试账号（请根据实际环境填写）
E2E_USERNAME=admin
E2E_PASSWORD=1qaz2wsx,.
# 租户编码（可选，单租户可留空）
E2E_TENANT_CODE=

# 测试运行行为
# 是否使用有头模式（true/false）
E2E_HEADED=false
# 单测超时时间（毫秒）
E2E_TIMEOUT=30000
